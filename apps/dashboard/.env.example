# *Supabase setup - learn more https://ailaeclass.com/docs/contributor-guides/supabase-cloud
PUBLIC_SUPABASE_URL=http://localhost:54321
PUBLIC_SUPABASE_ANON_KEY=
PRIVATE_SUPABASE_SERVICE_ROLE=

# Selfhosting - should be true if you are selfhosting
PUBLIC_IS_SELFHOSTED=false

# Unsplash setup - Optional if you want to use Unsplash images
UNSPLASH_API_KEY=

# OpenAI setup - Optional if you want to use the AI features
OPENAI_API_KEY=

# CAAC-M 150Kg course funnel. Keep real account data in Railway Variables.
FUNNEL_CALENDLY_URL=
FUNNEL_EBOOK_URL=/funnel-assets/CAAC-M-150Kg-course-ebook-preview.pdf
FUNNEL_SUPPORT_WHATSAPP=
FUNNEL_FPS_ID=
FUNNEL_FPS_ACCOUNT_NAME=AiLAE

# Hosted payment provider. Stripe is the primary gateway; manual FPS remains available as a fallback.
PAYMENT_PROVIDER=stripe

# Stripe-hosted Checkout. Start in test mode and use separate live credentials for production.
# Keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET server-side; never expose them through PUBLIC_ variables.
STRIPE_MODE=test
STRIPE_CURRENCY=HKD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_RETURN_URL=https://ailaeclass-production.up.railway.app/lms/payment

# Legacy Airwallex configuration retained for rollback during the Stripe migration.
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_RETURN_URL=https://ailaeclass-production.up.railway.app/lms/payment

# Sever URL - Optional if you want to use video upload and pdf downloads
# This is the deployment URL of apps/api
PUBLIC_SERVER_URL=http://localhost:3002

# For getting metadata for signup users.
PUBLIC_IP_REGISTRY_KEY=

# Domain management - should be your domain
# The final domain is app.ailaeclass.com where `app` is PRIVATE_APP_SUBDOMAINS and `ailaeclass.com` is PRIVATE_APP_HOST
PRIVATE_APP_HOST=ailaeclass.com
PRIVATE_APP_SUBDOMAINS=app


# ============  SINGLE-ORG MODE ============
# Set this to the siteName of your organization to enable single-org mode.
# This disables: subdomain routing, org creation, org switching, onboarding wizard.
# Users auto-join this org on signup. Leave empty for multi-tenant mode.
PUBLIC_SINGLE_ORG_SITE_NAME=

# ============  CLOUD VERSION SPECIFIC ============
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

VITE_SENTRY_AUTH_TOKEN=
VITE_SENTRY_ORG_NAME=
VITE_SENTRY_PROJECT_NAME=

# Configure https locally https://stackoverflow.com/a/76525335
USE_HTTPS_ON_LOCALHOST=false

## Custom Domain
TEAM_ID_VERCEL=
PROJECT_ID_VERCEL=
AUTH_BEARER_TOKEN=

# Salt used to irreversibly hash network identifiers in privacy audit records.
PRIVATE_AUDIT_SALT=
