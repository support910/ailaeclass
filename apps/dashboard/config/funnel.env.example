# Stripe Checkout
STRIPE_MODE=test
STRIPE_CURRENCY=HKD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_ACCOUNT_ID=
