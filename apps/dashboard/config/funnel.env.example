# ============================================================
# AiLAE Funnel production configuration
# Copy the required values to Railway Variables for production.
# For local testing, copy only the needed values to ../.env.local.
# Never commit real keys or passwords.
# ============================================================

# Course funnel
FUNNEL_CALENDLY_URL=https://calendly.com/your-team/caac-consultation
FUNNEL_EBOOK_URL=/funnel-assets/CAAC-M-150Kg-course-ebook-preview.pdf
